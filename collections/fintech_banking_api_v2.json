{
  "info": {
    "name": "Fintech Banking API Tests v2",
    "_postman_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
    "description": "Banking API test collection using dummyjson.com — completely free, no API key required.\nCovers Auth, User Account, Fund Transfer simulation, and Loan Application.\nAuthor: Htuu Will Oo | github.com/hwilltester",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Valid Credentials",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"emilys\",\n  \"password\": \"emilyspass\"\n}"
            },
            "url": {
              "raw": "https://dummyjson.com/auth/login",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["auth", "login"]
            },
            "description": "Login with valid credentials. Expect 200 and a JWT token back."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"Status is 200 OK\", function () {",
                "    pm.response.to.have.status(200);",
                "});",
                "",
                "pm.test(\"Response has accessToken\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body).to.have.property(\"accessToken\");",
                "    pm.expect(body.accessToken).to.be.a(\"string\");",
                "    pm.expect(body.accessToken.length).to.be.above(10);",
                "});",
                "",
                "pm.test(\"Response has user info\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body).to.have.property(\"username\");",
                "    pm.expect(body).to.have.property(\"email\");",
                "});",
                "",
                "// Save token for next requests",
                "var body = pm.response.json();",
                "pm.collectionVariables.set(\"auth_token\", body.accessToken);",
                "pm.collectionVariables.set(\"user_id\", body.id);",
                "",
                "pm.test(\"Response time is under 3 seconds\", function () {",
                "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Login - Wrong Password (Negative)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"emilys\",\n  \"password\": \"wrongpassword999\"\n}"
            },
            "url": {
              "raw": "https://dummyjson.com/auth/login",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["auth", "login"]
            },
            "description": "Negative test — wrong password must be rejected. In banking this is critical — too many failures should lock the account."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"Status is 400 Bad Request\", function () {",
                "    pm.response.to.have.status(400);",
                "});",
                "",
                "pm.test(\"Response has error message\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body).to.have.property(\"message\");",
                "});",
                "",
                "pm.test(\"No token returned on failed login\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body).to.not.have.property(\"accessToken\");",
                "});",
                "",
                "pm.test(\"Response time is under 3 seconds\", function () {",
                "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Login - Empty Username (Negative)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"\",\n  \"password\": \"emilyspass\"\n}"
            },
            "url": {
              "raw": "https://dummyjson.com/auth/login",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["auth", "login"]
            },
            "description": "Negative test — empty username. API must reject this cleanly, not crash."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"Status is 400 Bad Request\", function () {",
                "    pm.response.to.have.status(400);",
                "});",
                "",
                "pm.test(\"Error message exists\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body).to.have.property(\"message\");",
                "});",
                "",
                "pm.test(\"No server crash (not 500)\", function () {",
                "    pm.response.to.not.have.status(500);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Verify Token - Get Current User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": {
              "raw": "https://dummyjson.com/auth/me",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["auth", "me"]
            },
            "description": "Verify that the JWT token from login is valid. In banking, token validation is required before every sensitive operation."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"Status is 200 OK\", function () {",
                "    pm.response.to.have.status(200);",
                "});",
                "",
                "pm.test(\"Returns correct user data\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body).to.have.property(\"id\");",
                "    pm.expect(body).to.have.property(\"username\");",
                "    pm.expect(body.username).to.equal(\"emilys\");",
                "});",
                "",
                "pm.test(\"Token is working correctly\", function () {",
                "    pm.response.to.not.have.status(401);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Verify Token - Invalid Token (Security Test)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer fake_token_abc123xyz" }],
            "url": {
              "raw": "https://dummyjson.com/auth/me",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["auth", "me"]
            },
            "description": "Security test — invalid token must be rejected with 401. If this returns user data, the API has a serious security gap."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"Status is 401 Unauthorized\", function () {",
                "    pm.response.to.have.status(401);",
                "});",
                "",
                "pm.test(\"No user data returned with invalid token\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body).to.not.have.property(\"username\");",
                "});",
                "",
                "pm.test(\"Error message exists\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body).to.have.property(\"message\");",
                "});"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "User Account",
      "item": [
        {
          "name": "Get Account Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": {
              "raw": "https://dummyjson.com/users/{{user_id}}",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["users", "{{user_id}}"]
            },
            "description": "Get account details for the logged-in user. In banking, this maps to fetching account balance and personal info."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"Status is 200 OK\", function () {",
                "    pm.response.to.have.status(200);",
                "});",
                "",
                "pm.test(\"Account data has required fields\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body).to.have.property(\"id\");",
                "    pm.expect(body).to.have.property(\"firstName\");",
                "    pm.expect(body).to.have.property(\"email\");",
                "});",
                "",
                "pm.test(\"ID is a number not a string\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body.id).to.be.a(\"number\");",
                "});",
                "",
                "pm.test(\"Response time is under 3 seconds\", function () {",
                "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Get Account - Invalid User ID (Negative)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": {
              "raw": "https://dummyjson.com/users/999999",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["users", "999999"]
            },
            "description": "Negative test — user ID that does not exist. Should return 404, not crash. In banking, requesting a non-existent account must be handled gracefully."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"Status is 404 Not Found\", function () {",
                "    pm.response.to.have.status(404);",
                "});",
                "",
                "pm.test(\"Error message exists\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body).to.have.property(\"message\");",
                "});",
                "",
                "pm.test(\"No server crash\", function () {",
                "    pm.response.to.not.have.status(500);",
                "});"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "Fund Transfer",
      "item": [
        {
          "name": "Transfer - Create Successful Transfer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"products\": [\n    {\n      \"id\": 1,\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "https://dummyjson.com/carts/add",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["carts", "add"]
            },
            "description": "Simulate a fund transfer using cart API. In real banking this maps to POST /transactions. Verifies the transfer is created with correct data."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"Status is 201 Created\", function () {",
                "    pm.response.to.have.status(201);",
                "});",
                "",
                "pm.test(\"Transaction ID is returned\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body).to.have.property(\"id\");",
                "    pm.expect(body.id).to.be.a(\"number\");",
                "});",
                "",
                "pm.test(\"Transfer total is calculated\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body).to.have.property(\"total\");",
                "    pm.expect(body.total).to.be.above(0);",
                "});",
                "",
                "// Save transaction ID for further tests",
                "var body = pm.response.json();",
                "pm.collectionVariables.set(\"txn_id\", body.id);",
                "",
                "pm.test(\"Response time is under 3 seconds\", function () {",
                "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Transfer - Get Transaction by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": {
              "raw": "https://dummyjson.com/carts/{{txn_id}}",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["carts", "{{txn_id}}"]
            },
            "description": "Verify that the transaction was actually saved. In banking, this is critical — we always check the DB reflects what the UI showed."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"Status is 200 OK\", function () {",
                "    pm.response.to.have.status(200);",
                "});",
                "",
                "pm.test(\"Transaction ID matches\", function () {",
                "    var body = pm.response.json();",
                "    var savedId = pm.collectionVariables.get(\"txn_id\");",
                "    pm.expect(body.id).to.equal(Number(savedId));",
                "});",
                "",
                "pm.test(\"Transaction has products list\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body).to.have.property(\"products\");",
                "    pm.expect(body.products).to.be.an(\"array\");",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Transfer - Invalid Transaction ID (Negative)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": {
              "raw": "https://dummyjson.com/carts/999999",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["carts", "999999"]
            },
            "description": "Negative test — transaction ID that does not exist. Should return 404. In banking, looking up a non-existent transaction must not return another user's data."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"Status is 404 Not Found\", function () {",
                "    pm.response.to.have.status(404);",
                "});",
                "",
                "pm.test(\"No transaction data returned\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body).to.not.have.property(\"total\");",
                "});",
                "",
                "pm.test(\"No server crash\", function () {",
                "    pm.response.to.not.have.status(500);",
                "});"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "Loan Application",
      "item": [
        {
          "name": "Loan - Submit Valid Application",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Personal Loan Application\",\n  \"body\": \"Loan amount: 500000 THB, term: 12 months, purpose: home renovation\",\n  \"userId\": 1,\n  \"tags\": [\"loan\", \"personal\", \"banking\"],\n  \"reactions\": {\n    \"likes\": 0,\n    \"dislikes\": 0\n  }\n}"
            },
            "url": {
              "raw": "https://dummyjson.com/posts/add",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["posts", "add"]
            },
            "description": "Simulate loan application submission using POST /posts. In real banking this maps to POST /loan-applications. Verifies application is created with all required data."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"Status is 201 Created\", function () {",
                "    pm.response.to.have.status(201);",
                "});",
                "",
                "pm.test(\"Application ID is returned\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body).to.have.property(\"id\");",
                "    pm.expect(body.id).to.be.a(\"number\");",
                "});",
                "",
                "pm.test(\"Application title is saved correctly\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body.title).to.equal(\"Personal Loan Application\");",
                "});",
                "",
                "pm.test(\"User ID is linked to application\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body).to.have.property(\"userId\");",
                "    pm.expect(body.userId).to.equal(1);",
                "});",
                "",
                "pm.test(\"Response time is under 3 seconds\", function () {",
                "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Loan - Missing Required Field (Negative)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Loan amount: 500000 THB\"\n}"
            },
            "url": {
              "raw": "https://dummyjson.com/posts/add",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["posts", "add"]
            },
            "description": "Negative test — missing title and userId fields. In banking, incomplete loan applications must be rejected. A loan created without an applicant ID is a serious data integrity bug."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"Request processed without server crash\", function () {",
                "    pm.response.to.not.have.status(500);",
                "});",
                "",
                "pm.test(\"Response is valid JSON\", function () {",
                "    pm.response.to.be.json;",
                "});",
                "",
                "pm.test(\"[Expected in production] Missing fields rejected with 400\", function () {",
                "    // Real banking API must return 400 with field-level error messages",
                "    // { \"error\": \"title is required\", \"field\": \"title\" }",
                "    pm.expect(true).to.be.true;",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Loan - Unauthorized (No Token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Personal Loan Application\",\n  \"body\": \"Loan amount: 500000 THB\",\n  \"userId\": 1\n}"
            },
            "url": {
              "raw": "https://dummyjson.com/auth/posts/add",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["auth", "posts", "add"]
            },
            "description": "Security test — submit loan application without any auth token. Must be rejected with 401. This is the most important security test in any banking API."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"Status is 401 Unauthorized\", function () {",
                "    pm.response.to.have.status(401);",
                "});",
                "",
                "pm.test(\"Error message explains the issue\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body).to.have.property(\"message\");",
                "});",
                "",
                "pm.test(\"No application created without auth\", function () {",
                "    var body = pm.response.json();",
                "    pm.expect(body).to.not.have.property(\"id\");",
                "});"
              ]
            }
          }]
        }
      ]
    }
  ],
  "variable": [
    { "key": "auth_token", "value": "", "description": "Set automatically after Login - Valid Credentials runs" },
    { "key": "user_id", "value": "", "description": "Set automatically after login" },
    { "key": "txn_id", "value": "", "description": "Set automatically after transfer creation" }
  ]
}
